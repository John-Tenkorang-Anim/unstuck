# With no API URL the app uses clearly labeled, read-only example entries.
# Set this server-only value to connect public read requests to FastAPI.
# UNSTUCK_API_URL=http://127.0.0.1:8000/api/v1
# Optional bare HTTPS origin for approved CDN assets. Empty means same-origin /m/.
# UNSTUCK_MEDIA_ORIGIN=https://media.example.org

# Sharing (sessions, notes, field notes, accounts, moderation) needs PostgreSQL.
# `npm run db:start` runs a private local cluster and prints this URL.
# DATABASE_URL=postgresql://unstuck@127.0.0.1:5433/unstuck
# Uploaded file bytes are stored here; the database keeps their metadata.
# UNSTUCK_DATA_DIR=.data
# Anyone who enters this code on /account becomes a moderator. Use 12+ characters.
# UNSTUCK_MODERATOR_CODE=
# What waits for a moderator before others can see it: all, media (video and PDF) or none.
# Defaults to all in production and none in development.
# UNSTUCK_UPLOAD_REVIEW=all
# Optional scanning service. Receives the file and answers {"verdict":"clean"|"review"|"block"}.
# UNSTUCK_SCAN_URL=
# PDQ hash list of known abuse imagery from an industry hash-sharing programme:
# one 64-character hex hash per line, optionally ",label". Matching uploads are
# quarantined, their uploader suspended, and moderators alerted to report them.
# UNSTUCK_HASH_LIST=/secure/path/pdq-hashes.txt
# UNSTUCK_HASH_THRESHOLD=31
# Store uploaded files in S3, Cloudflare R2, MinIO or another S3-compatible
# service instead of the local disk, so several machines share them.
# UNSTUCK_S3_BUCKET=
# UNSTUCK_S3_REGION=auto
# UNSTUCK_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# UNSTUCK_S3_ACCESS_KEY_ID=
# UNSTUCK_S3_SECRET_ACCESS_KEY=
# UNSTUCK_S3_FORCE_PATH_STYLE=false
